diff --git a/fs/sus_su.c b/fs/sus_su.c
new file mode 100644
index 000000000..d140468d0
--- /dev/null
+++ b/fs/sus_su.c
@@ -0,0 +1,140 @@
+#include <linux/module.h>
+#include <linux/kernel.h>
+#include <linux/fs.h>
+#include <linux/uaccess.h>
+#include <linux/cdev.h>
+#include <linux/random.h>
+#include <linux/cred.h>
+#include <linux/sus_su.h>
+
+#ifdef CONFIG_KSU_SUSFS_ENABLE_LOG
+extern bool susfs_is_log_enabled __read_mostly;
+#define SUSFS_LOGI(fmt, ...) if (susfs_is_log_enabled) pr_info("susfs_sus_su:[%u][%u][%s] " fmt, current_uid().val, current->pid, __func__, ##__VA_ARGS__)
+#define SUSFS_LOGE(fmt, ...) if (susfs_is_log_enabled) pr_err("susfs_sus_su:[%u][%u][%s]" fmt, current_uid().val, current->pid, __func__, ##__VA_ARGS__)
+#else
+#define SUSFS_LOGI(fmt, ...)
+#define SUSFS_LOGE(fmt, ...)
+#endif
+
+#define FIFO_SIZE 1024
+#define MAX_DRV_NAME 255
+
+static int cur_maj_dev_num = -1;
+static char fifo_buffer[FIFO_SIZE];
+static struct cdev sus_su_cdev;
+static const char *sus_su_token = "!@#$SU_IS_SUS$#@!-pRE6W9BKXrJr1hEKyvDq0CvWziVKbatT8yzq06fhtrEGky2tVS7Q2QTjhtMfVMGV";
+static char rand_drv_path[MAX_DRV_NAME+1] = "/dev/";
+static bool is_sus_su_enabled_before = false;
+
+extern bool susfs_is_allow_su(void);
+extern void ksu_escape_to_root(void);
+
+static void gen_rand_drv_name(char *buffer, size_t min_length, size_t max_length) {
+    const char *symbols = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_-+@#:=";
+    size_t symbols_length = strlen(symbols);
+    size_t length, i;
+    unsigned int rand_value;
+
+    // Determine the random length of the string
+    get_random_bytes(&rand_value, sizeof(rand_value));
+    length = min_length + (rand_value % (max_length - min_length + 1));
+
+    for (i = 0; i < length; ++i) {
+        get_random_bytes(&rand_value, sizeof(rand_value));
+        buffer[i] = symbols[rand_value % symbols_length];
+    }
+    buffer[length] = '\0'; // Null-terminate the string
+}
+
+static int fifo_open(struct inode *inode, struct file *file) {
+    return 0;
+}
+
+static int fifo_release(struct inode *inode, struct file *file) {
+    return 0;
+}
+
+static ssize_t fifo_read(struct file *file, char __user *buf, size_t len, loff_t *offset) {
+    return 0;
+}
+
+static ssize_t fifo_write(struct file *file, const char __user *buf, size_t len, loff_t *offset) {
+    int sus_su_token_len = strlen(sus_su_token);
+
+    if (!susfs_is_allow_su()) {
+        SUSFS_LOGE("root is not allowed for uid: '%d', pid: '%d'\n", current_uid().val, current->pid);
+        return 0;
+    }
+
+    if (copy_from_user(fifo_buffer, buf, sus_su_token_len+1)) {
+        SUSFS_LOGE("copy_from_user() failed, uid: '%d', pid: '%d'\n", current_uid().val, current->pid);
+        return 0;
+    }
+
+    if (!memcmp(fifo_buffer, sus_su_token, sus_su_token_len+1)) {
+        SUSFS_LOGI("granting root access for uid: '%d', pid: '%d'\n", current_uid().val, current->pid);
+        ksu_escape_to_root();
+    } else {
+        SUSFS_LOGI("wrong token! deny root access for uid: '%d', pid: '%d'\n", current_uid().val, current->pid);
+    }
+    memset(fifo_buffer, 0, FIFO_SIZE);
+    return 0;
+}
+
+static struct file_operations fops = {
+    .owner = THIS_MODULE,
+    .open = fifo_open,
+    .release = fifo_release,
+    .read = fifo_read,
+    .write = fifo_write,
+};
+
+int sus_su_fifo_init(int *maj_dev_num, char *drv_path) {
+    if (cur_maj_dev_num > 0) {
+        SUSFS_LOGE("'%s' is already registered\n", rand_drv_path);
+        return -1;
+    }
+
+    // generate a random driver name if it is executed for the first time
+    if (!is_sus_su_enabled_before) {
+        // min length 192, max length 248, just make sure max length doesn't exceeds 255
+        gen_rand_drv_name(rand_drv_path+5, 192, 248);
+    }
+
+    cur_maj_dev_num = register_chrdev(0, rand_drv_path+5, &fops);
+    if (cur_maj_dev_num < 0) {
+        SUSFS_LOGE("Failed to register character device\n");
+        return -1;
+    }
+
+    cdev_init(&sus_su_cdev, &fops);
+    if (cdev_add(&sus_su_cdev, MKDEV(cur_maj_dev_num, 0), 1) < 0) {
+        unregister_chrdev(cur_maj_dev_num, rand_drv_path+5);
+        SUSFS_LOGE("Failed to add cdev\n");
+        return -1;
+    }
+
+    strncpy(drv_path, rand_drv_path, strlen(rand_drv_path));
+    *maj_dev_num = cur_maj_dev_num;
+    SUSFS_LOGI("'%s' registered with major device number %d\n", rand_drv_path, cur_maj_dev_num);
+    
+    if (!is_sus_su_enabled_before)
+        is_sus_su_enabled_before = true;
+
+    return 0;
+}
+
+int sus_su_fifo_exit(int *maj_dev_num, char *drv_path) {
+    if (cur_maj_dev_num < 0) {
+        SUSFS_LOGE("'%s' was already unregistered before\n", rand_drv_path);
+        return 0;
+    }
+
+    cdev_del(&sus_su_cdev);
+    unregister_chrdev(cur_maj_dev_num, rand_drv_path+5);
+    cur_maj_dev_num = -1;
+    *maj_dev_num = cur_maj_dev_num;
+    strncpy(drv_path, rand_drv_path, strlen(rand_drv_path));
+    SUSFS_LOGI("'%s' unregistered\n", rand_drv_path);
+    return 0;
+}
diff --git a/fs/susfs.c b/fs/susfs.c
new file mode 100644
index 000000000..03aeb613e
--- /dev/null
+++ b/fs/susfs.c
@@ -0,0 +1,1341 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * SUSFS kernel side for kernel 4.9 (non-GKI), UAPI aligned to SUSFS v2.3.0.
+ *
+ * The feature engine is the 4.9-native one (hook glue already applied to
+ * fs/namei.c, fs/readdir.c, fs/stat.c, fs/namespace.c, fs/proc, fs/dcache.c,
+ * fs/statfs.c, fs/notify/fdinfo.c, fs/overlayfs), while every userspace
+ * facing structure / command semantic follows SUSFS v2.3.0 so that the
+ * SukiSU Ultra (>= 4.1.x) ksud / ksu_susfs tool speaks the same ABI.
+ */
+#include <linux/version.h>
+#include <linux/stddef.h>
+#include <linux/cred.h>
+#include <linux/fs.h>
+#include <linux/slab.h>
+#include <linux/seq_file.h>
+#include <linux/printk.h>
+#include <linux/namei.h>
+#include <linux/list.h>
+#include <linux/init_task.h>
+#include <linux/spinlock.h>
+#include <linux/stat.h>
+#include <linux/uaccess.h>
+#include <linux/fdtable.h>
+#include <linux/statfs.h>
+#include <linux/string.h>
+#include <linux/security.h>
+#include <linux/susfs.h>
+#include "mount.h"
+
+static spinlock_t susfs_spin_lock;
+
+extern bool susfs_is_current_ksu_domain(void);
+#ifdef CONFIG_KSU_SUSFS_SUS_MOUNT
+extern void ksu_try_umount(const char *mnt, bool check_mnt, int flags, uid_t uid);
+#endif
+
+#ifdef CONFIG_KSU_SUSFS_ENABLE_LOG
+bool susfs_is_log_enabled __read_mostly = true;
+#define SUSFS_LOGI(fmt, ...) if (susfs_is_log_enabled) pr_info("susfs:[%u][%d][%s] " fmt, current_uid().val, current->pid, __func__, ##__VA_ARGS__)
+#define SUSFS_LOGE(fmt, ...) if (susfs_is_log_enabled) pr_err("susfs:[%u][%d][%s]" fmt, current_uid().val, current->pid, __func__, ##__VA_ARGS__)
+#else
+#define SUSFS_LOGI(fmt, ...)
+#define SUSFS_LOGE(fmt, ...)
+#endif
+
+/*
+ * Pathname-bearing SUSFS payloads come in two wire layouts:
+ *
+ *   v2.3.0  target_pathname at offset 0
+ *   v2.0.0  an 8-byte `target_ino` prefix, target_pathname at offset 8
+ *
+ * The v2.0.0 layout is what the SukiSU Ultra 4.1.x manager actually drives:
+ * it derives the tool name from the version the kernel reports and, when that
+ * asset is missing, falls back to the only one it ships -- ksu_susfs_2.0.0.
+ * Reporting the v2.3.0 layout as well keeps ksud working.
+ *
+ * A pathname is always absolute, so the first byte identifies the layout.
+ * Returns the pathname offset (0 or 8) or a negative errno.
+ *
+ * Shared by sus_path and open_redirect, hence the combined guard.
+ */
+#if defined(CONFIG_KSU_SUSFS_SUS_PATH) || defined(CONFIG_KSU_SUSFS_OPEN_REDIRECT)
+#define SUSFS_LEGACY_INO_PREFIX 8
+
+static int susfs_pathname_offset(void __user *base)
+{
+	unsigned char probe[16];
+
+	if (copy_from_user(probe, base, sizeof(probe)))
+		return -EFAULT;
+	if (probe[0] == '/')
+		return 0;
+	if (probe[8] == '/')
+		return SUSFS_LEGACY_INO_PREFIX;
+	return -EINVAL;
+}
+#endif
+
+/* sus_path */
+#ifdef CONFIG_KSU_SUSFS_SUS_PATH
+static DEFINE_HASHTABLE(SUS_PATH_HLIST, 10);
+static int susfs_update_sus_path_inode(char *target_pathname) {
+	struct path p;
+	struct inode *inode = NULL;
+	const char *dev_type;
+
+	if (kern_path(target_pathname, LOOKUP_FOLLOW, &p)) {
+		/*
+		 * SUSFS_LOGI, not SUSFS_LOGE: this helper is called from a
+		 * kworker on every setresuid, and pr_err reaches the console
+		 * (console_loglevel is 4 on this ROM) whereas pr_info does
+		 * not.  A path the kernel domain cannot resolve would
+		 * otherwise flood the console on every app switch.  Callers
+		 * report the failure to userspace, and
+		 * susfs_run_sus_path_loop() bounds the number of retries.
+		 */
+		SUSFS_LOGI("Failed opening file '%s'\n", target_pathname);
+		return 1;
+	}
+
+	// - We don't allow paths of which filesystem type is "tmpfs" or "fuse".
+	//   For tmpfs, because its starting inode->i_ino will begin with 1 again,
+	//   so it will cause wrong comparison in function susfs_sus_ino_for_filldir64()
+	//   For fuse, which is almost storage related, sus_path should not handle any paths of
+	//   which filesystem is "fuse" as well, since app can write to "fuse" and lookup files via
+	//   like binder / system API (you can see the uid is changed to 1000)/
+	// - so sus_path should be applied only on read-only filesystem like "erofs" or "f2fs", but not "tmpfs" or "fuse",
+	//   people may rely on HMA for /data isolation instead.
+	dev_type = p.mnt->mnt_sb->s_type->name;
+	if (!strcmp(dev_type, "tmpfs") ||
+		!strcmp(dev_type, "fuse")) {
+		/* Intentional skip, not a failure -- keep it off the console. */
+		SUSFS_LOGI("target_pathname: '%s' cannot be added since its filesystem type is '%s'\n",
+						target_pathname, dev_type);
+		path_put(&p);
+		return 1;
+	}
+
+	inode = d_inode(p.dentry);
+	if (!inode) {
+		SUSFS_LOGE("inode is NULL\n");
+		path_put(&p);
+		return 1;
+	}
+
+	if (!(inode->i_state & INODE_STATE_SUS_PATH)) {
+		spin_lock(&inode->i_lock);
+		inode->i_state |= INODE_STATE_SUS_PATH;
+		spin_unlock(&inode->i_lock);
+	}
+	path_put(&p);
+	return 0;
+}
+
+/* err lives at a different offset in each layout. */
+static unsigned long susfs_path_err_offset(int path_off)
+{
+	return path_off ? offsetof(struct st_susfs_sus_path_v200, err)
+			: offsetof(struct st_susfs_sus_path, err);
+}
+
+/* User supplies only target_pathname; the kernel resolves the inode itself,
+ * so target_ino/target_uid of the legacy layout are ignored. */
+void susfs_add_sus_path(void __user **user_info) {
+	struct st_susfs_sus_path info = {0};
+	struct st_susfs_sus_path_hlist *new_entry, *tmp_entry;
+	struct hlist_node *tmp_node;
+	void __user *base = *user_info;
+	unsigned long err_off = offsetof(struct st_susfs_sus_path, err);
+	struct path p;
+	int bkt, path_off;
+	bool update_hlist = false;
+
+	path_off = susfs_pathname_offset(base);
+	if (path_off < 0) {
+		info.err = path_off;
+		path_off = 0;			/* best-effort reply slot */
+		goto out_copy_to_user;
+	}
+	err_off = susfs_path_err_offset(path_off);
+
+	if (copy_from_user(info.target_pathname, (char __user *)base + path_off,
+			sizeof(info.target_pathname))) {
+		info.err = -EFAULT;
+		goto out_copy_to_user;
+	}
+	info.target_pathname[SUSFS_MAX_LEN_PATHNAME - 1] = '\0';
+
+	info.err = kern_path(info.target_pathname, LOOKUP_FOLLOW, &p);
+	if (info.err) {
+		SUSFS_LOGE("failed opening file '%s'\n", info.target_pathname);
+		goto out_copy_to_user;
+	}
+	path_put(&p);
+
+	spin_lock(&susfs_spin_lock);
+	hash_for_each_safe(SUS_PATH_HLIST, bkt, tmp_node, tmp_entry, node) {
+		if (!strcmp(tmp_entry->target_pathname, info.target_pathname)) {
+			hash_del(&tmp_entry->node);
+			kfree(tmp_entry);
+			update_hlist = true;
+			break;
+		}
+	}
+	spin_unlock(&susfs_spin_lock);
+
+	new_entry = kmalloc(sizeof(struct st_susfs_sus_path_hlist), GFP_KERNEL);
+	if (!new_entry) {
+		SUSFS_LOGE("no enough memory\n");
+		info.err = -ENOMEM;
+		goto out_copy_to_user;
+	}
+
+	strncpy(new_entry->target_pathname, info.target_pathname, SUSFS_MAX_LEN_PATHNAME-1);
+	if (susfs_update_sus_path_inode(new_entry->target_pathname)) {
+		kfree(new_entry);
+		info.err = -ENOENT;
+		goto out_copy_to_user;
+	}
+
+	info.err = kern_path(new_entry->target_pathname, LOOKUP_FOLLOW, &p);
+	if (info.err) {
+		kfree(new_entry);
+		goto out_copy_to_user;
+	}
+	new_entry->target_ino = d_inode(p.dentry)->i_ino;
+	path_put(&p);
+
+	spin_lock(&susfs_spin_lock);
+	hash_add(SUS_PATH_HLIST, &new_entry->node, new_entry->target_ino);
+	spin_unlock(&susfs_spin_lock);
+
+	if (update_hlist) {
+		SUSFS_LOGI("target_ino: '%lu', target_pathname: '%s' is successfully updated to SUS_PATH_HLIST\n",
+				new_entry->target_ino, new_entry->target_pathname);
+	} else {
+		SUSFS_LOGI("target_ino: '%lu', target_pathname: '%s' is successfully added to SUS_PATH_HLIST\n",
+				new_entry->target_ino, new_entry->target_pathname);
+	}
+	info.err = 0;
+out_copy_to_user:
+	if (copy_to_user((char __user *)base + err_off, &info.err, sizeof(info.err))) {
+		info.err = -EFAULT;
+	}
+	SUSFS_LOGI("CMD_SUSFS_ADD_SUS_PATH -> ret: %d\n", info.err);
+}
+
+int susfs_sus_ino_for_filldir64(unsigned long ino) {
+	struct st_susfs_sus_path_hlist *entry;
+
+	hash_for_each_possible(SUS_PATH_HLIST, entry, node, ino) {
+		if (entry->target_ino == ino)
+			return 1;
+	}
+	return 0;
+}
+
+/* ---- sus_path_loop: keep re-flagging entries whose file gets replaced ---- */
+static DEFINE_SPINLOCK(susfs_spin_lock_sus_path);
+static LIST_HEAD(LH_SUS_PATH_LOOP);
+
+/*
+ * CMD_SUSFS_ADD_SUS_PATH_LOOP handler.
+ *
+ * The payload is the same st_susfs_sus_path as ADD_SUS_PATH, so the very same
+ * dual-layout probing applies: the SukiSU Ultra 4.1.x tool sends the v2.0.0
+ * layout (8-byte target_ino prefix, err @ 268), while ksud may send v2.3.0
+ * (no prefix, err @ 264).
+ *
+ * The inode is flagged immediately here as well as on every later setresuid,
+ * and a path that cannot be flagged is rejected rather than enqueued -- see
+ * the comment at the flagging site below.
+ */
+void susfs_add_sus_path_loop(void __user **user_info) {
+	struct st_susfs_sus_path_list *new_list = NULL;
+	struct st_susfs_sus_path_list *cursor = NULL;
+	void __user *base = *user_info;
+	unsigned long err_off = offsetof(struct st_susfs_sus_path, err);
+	char pathname[SUSFS_MAX_LEN_PATHNAME];
+	int path_off;
+	int err;
+
+	path_off = susfs_pathname_offset(base);
+	if (path_off < 0) {
+		err = path_off;
+		path_off = 0;			/* best-effort reply slot */
+		goto out_copy_to_user;
+	}
+	err_off = susfs_path_err_offset(path_off);
+
+	if (copy_from_user(pathname, (char __user *)base + path_off, sizeof(pathname))) {
+		err = -EFAULT;
+		goto out_copy_to_user;
+	}
+	pathname[SUSFS_MAX_LEN_PATHNAME - 1] = '\0';
+
+	if (pathname[0] == '\0') {
+		SUSFS_LOGE("target_pathname cannot be empty\n");
+		err = -EINVAL;
+		goto out_copy_to_user;
+	}
+
+	new_list = kmalloc(sizeof(struct st_susfs_sus_path_list), GFP_KERNEL);
+	if (!new_list) {
+		SUSFS_LOGE("no enough memory\n");
+		err = -ENOMEM;
+		goto out_copy_to_user;
+	}
+
+	strscpy(new_list->target_pathname, pathname, sizeof(new_list->target_pathname));
+	new_list->path_len = strlen(new_list->target_pathname);
+	new_list->fail_count = 0;
+	INIT_LIST_HEAD(&new_list->list);
+
+	/*
+	 * Resolve and flag the inode right now rather than waiting for the next
+	 * setresuid.  If it cannot be flagged here the workqueue would not
+	 * manage it either -- the kworker runs in the "kernel" domain, which is
+	 * at least as restricted as the caller -- so report the failure and do
+	 * not enqueue the path.  This is what keeps a path the kernel domain can
+	 * never resolve from being retried on every app switch.
+	 */
+	if (susfs_update_sus_path_inode(new_list->target_pathname)) {
+		kfree(new_list);
+		err = -ENOENT;
+		goto out_copy_to_user;
+	}
+
+	spin_lock(&susfs_spin_lock_sus_path);
+	/*
+	 * Re-registering a path that is already listed must not create a second
+	 * entry -- the manager re-applies its whole path list on every start, and
+	 * two entries would mean two kern_path() walks per setresuid for the same
+	 * file.  The flagging above is idempotent, so returning 0 is correct.
+	 */
+	list_for_each_entry(cursor, &LH_SUS_PATH_LOOP, list) {
+		if (!strcmp(cursor->target_pathname, new_list->target_pathname)) {
+			spin_unlock(&susfs_spin_lock_sus_path);
+			kfree(new_list);
+			SUSFS_LOGI("target_pathname: '%s' is already in LH_SUS_PATH_LOOP\n",
+						pathname);
+			err = 0;
+			goto out_copy_to_user;
+		}
+	}
+	list_add_tail(&new_list->list, &LH_SUS_PATH_LOOP);
+	spin_unlock(&susfs_spin_lock_sus_path);
+
+	SUSFS_LOGI("target_pathname: '%s' is successfully added to LH_SUS_PATH_LOOP\n",
+				new_list->target_pathname);
+	err = 0;
+out_copy_to_user:
+	if (copy_to_user((char __user *)base + err_off, &err, sizeof(err)))
+		err = -EFAULT;
+	SUSFS_LOGI("CMD_SUSFS_ADD_SUS_PATH_LOOP -> ret: %d\n", err);
+}
+
+/*
+ * Re-flag every registered path.
+ *
+ * Called from a workqueue (scheduled by ksu_handle_setresuid()) so we run in
+ * process context with root creds, and the kern_path() inside
+ * susfs_update_sus_path_inode() is free to sleep.
+ *
+ * Only one instance can ever run -- schedule_work() on an already-queued work
+ * item is a no-op and there is exactly one susfs_extra_works -- so deletion is
+ * serialised against itself.  list_add_tail() from the syscall path is the
+ * only other writer, hence the spinlock is taken around the list_del() only,
+ * never across the sleeping kern_path().
+ */
+void susfs_run_sus_path_loop(void) {
+	struct st_susfs_sus_path_list *cursor = NULL;
+	struct st_susfs_sus_path_list *tmp = NULL;
+
+	list_for_each_entry_safe(cursor, tmp, &LH_SUS_PATH_LOOP, list) {
+		if (cursor->target_pathname[0] == '\0')
+			continue;
+		if (susfs_update_sus_path_inode(cursor->target_pathname)) {
+			/*
+			 * The kworker's SELinux domain is "kernel"; a path it
+			 * cannot resolve keeps failing on every setresuid for
+			 * as long as it stays registered.  Report the first
+			 * failure, then drop the entry once the budget is
+			 * spent so the noise cannot repeat every app switch.
+			 */
+			cursor->fail_count++;
+			if (cursor->fail_count == 1)
+				SUSFS_LOGI("cannot re-flag path '%s', retrying up to %d times\n",
+						cursor->target_pathname,
+						SUSFS_SUS_PATH_LOOP_MAX_RETRY);
+			if (cursor->fail_count >= SUSFS_SUS_PATH_LOOP_MAX_RETRY) {
+				SUSFS_LOGI("giving up on path '%s' after %u failures, removing it from LH_SUS_PATH_LOOP\n",
+						cursor->target_pathname, cursor->fail_count);
+				spin_lock(&susfs_spin_lock_sus_path);
+				list_del(&cursor->list);
+				spin_unlock(&susfs_spin_lock_sus_path);
+				kfree(cursor);
+			}
+			continue;
+		}
+		cursor->fail_count = 0;
+		SUSFS_LOGI("re-flagged INODE_STATE_SUS_PATH on path '%s'\n",
+					cursor->target_pathname);
+	}
+}
+
+/*
+ * Scheduled from ksu_handle_setresuid(); see drivers/kernelsu/setuid_hook.c.
+ * Kept static and exposed through susfs_schedule_extra_works() so that the
+ * only cross-TU reference is a function call -- a bare `struct work_struct`
+ * at file scope would be a tentative definition and modpost would flag it as
+ * a COMMON symbol.
+ */
+static struct work_struct susfs_extra_works;
+
+static void susfs_run_extra_works(struct work_struct *work) {
+	susfs_run_sus_path_loop();
+}
+
+void susfs_schedule_extra_works(void) {
+	schedule_work(&susfs_extra_works);
+}
