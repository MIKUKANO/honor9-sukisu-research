+// IMPORTANT NOTE: the call from execve_handler_pre WON'T provided correct value for envp and flags in GKI version
+int ksu_handle_execveat_ksud(int *fd, struct filename **filename_ptr,
+                             struct user_arg_ptr *argv,
+                             struct user_arg_ptr *envp, int *flags)
+{
+    struct filename *filename;
+
+    static const char app_process[] = "/system/bin/app_process";
+    static bool first_zygote = true;
+
+    /* This applies to versions Android 10+ */
+    static const char system_bin_init[] = "/system/bin/init";
+    static bool init_second_stage_executed = false;
+
+    if (!filename_ptr)
+        return 0;
+
+    filename = *filename_ptr;
+    if (IS_ERR(filename)) {
+        return 0;
+    }
+
+    // https://cs.android.com/android/platform/superproject/+/android-16.0.0_r2:system/core/init/main.cpp;l=77
+    if (unlikely(!memcmp(filename->name, system_bin_init,
+                         sizeof(system_bin_init) - 1) &&
+                 argv)) {
+        char buf[16];
+        if (!init_second_stage_executed &&
+            check_argv(*argv, 1, "second_stage", buf, sizeof(buf))) {
+            pr_info("/system/bin/init second_stage executed\n");
+            apply_kernelsu_rules();
+            cache_sid();
+            setup_ksu_cred();
+            init_second_stage_executed = true;
+        }
+    }
+
+    if (unlikely(
+            first_zygote &&
+            !memcmp(filename->name, app_process, sizeof(app_process) - 1) &&
+            argv)) {
+        char buf[16];
+        if (check_argv(*argv, 1, "-Xzygote", buf, sizeof(buf))) {
+            pr_info("exec zygote, /data prepared, second_stage: %d\n",
+                    init_second_stage_executed);
+            rcu_read_lock();
+            struct task_struct *init_task =
+                rcu_dereference(current->real_parent);
+            if (init_task)
+                task_work_add(init_task, &on_post_fs_data_cb, TWA_RESUME);
+            rcu_read_unlock();
+            first_zygote = false;
+            stop_execve_hook();
+        }
+    }
+
+    return 0;
+}
+
+/*
+ * 供 syscall tracepoint (sys_enter, __NR_execve) 调用。
+ *
+ * 原实现是 kprobe 挂 __arm64_sys_execve（见下方 sys_execve_handler_pre），
+ * 但本内核 CONFIG_KPROBES=n，register_kprobe() 恒返回 -ENOSYS，
+ * 该 kprobe 从未注册成功 —— 这意味着：
+ *   (1) 永远检测不到 zygote 启动，on_post_fs_data() 不会被触发，
+ *       ksu_load_allow_list() 从不执行（授权读不回来）；
+ *   (2) 上面的 system_bin_init / app_process 分支形同虚设。
+ * 因此把这段逻辑搬到已验证可用的 sys_enter tracepoint 上。
+ *
+ * filename_user : 指向用户态 execve 第一个参数（路径字符串指针）的指针
+ * __argv        : 用户态 argv 数组（用于识别 "-Xzygote" / "second_stage"）
+ */
+int ksu_handle_execve_ksud(const char __user **filename_user,
+                           const char __user *const __user *__argv)
+{
+    const char __user *fn;
+    unsigned long addr;
+    char path[32];
+    long ret;
+    struct filename filename_in, *filename_p;
+    struct user_arg_ptr argv = { .ptr.native = __argv };
+
+    if (unlikely(!filename_user))
+        return 0;
+
+    /* 廉价前置过滤。本函数只关心两种情况：
+     *   ① init 执行 /system/bin/app_process -Xzygote   （zygote 首次启动）
+     *   ② init 执行 /system/bin/init second_stage       （Android 10+）
+     * 两者的发起者都是 init 本身（pid 1），或 init fork 出的子进程
+     * —— 后者在 execve **之前** comm 仍继承父进程的 "init"。
+     *
+     * 不加这道门，会对全系统**每一次** execve 都尝试读用户态路径字符串。
+     * 实测（v20 首次刷入）每次开机因此产生约 1000 条
+     * "Access filename when execve failed: -14" 噪声，污染 dmesg 环形缓冲
+     * —— 而环形缓冲被冲掉正是早期启动证据查不到的原因，反过来又妨碍排查。
+     * 参照：sucompat.c 有等价的 `ksu_is_allow_uid_for_current()` 前置门。
+     *
+     * ⚠️ v21 的教训：**不能**用 `current_uid().val == 0` 当门。
+     * zygote / zygote64 本身就是 uid 0、comm 为 "main" 的进程，它们的
+     * 每一次 execve 都会因 uid==0 通过这道门并报错 —— v21 实测每次开机
+     * 残余 965 条 "Access filename when execve failed: -14"（pid 561/563
+     * 即 zygote64/zygote）。只有 "pid==1 || comm==init" 才精确命中目标。
+     */
+    if (unlikely(current->pid != 1 && strcmp(current->comm, "init")))
+        return 0;
+
+    addr = untagged_addr((unsigned long)*filename_user);
+    fn = (const char __user *)addr;
+
+    memset(path, 0, sizeof(path));
+    ret = strncpy_from_user_nofault(path, fn, sizeof(path));
+    if (ret < 0 && try_set_access_flag(addr)) {
+        ret = strncpy_from_user_nofault(path, fn, sizeof(path));
+    }
+    if (ret < 0 && preempt_count()) {
+        /* sys_enter tracepoint 由 trace_sys_enter() 在 rcu_read_lock_sched()
+         * 保护下调用，此时 preempt_count() != 0 —— 原子上下文不允许触发页
+         * 错误，因此 strncpy_from_user 对「页面未驻留」的路径会直接返回
+         * -EFAULT。这里临时退出原子上下文把页错误处理掉再恢复。
+         * 与 sucompat.c:ksu_handle_execve_sucompat() 用的是同一套逃生逻辑。 */
+        preempt_enable_no_resched_notrace();
+        ret = strncpy_from_user(path, fn, sizeof(path));
+        preempt_disable_notrace();
+    }
+    if (ret < 0) {
+        pr_warn("Access filename when execve failed: %ld\n", ret);
+        return 0;
+    }
+
+    filename_in.name = path;
+    filename_p = &filename_in;
+    return ksu_handle_execveat_ksud(NULL, &filename_p, &argv, NULL, NULL);
+}
+
+static ssize_t (*orig_read)(struct file *, char __user *, size_t, loff_t *);
+static ssize_t (*orig_read_iter)(struct kiocb *, struct iov_iter *);
+static struct file_operations fops_proxy;
+static ssize_t ksu_rc_pos = 0;
+const size_t ksu_rc_len = sizeof(KERNEL_SU_RC) - 1;
+
+// https://cs.android.com/android/platform/superproject/main/+/main:system/core/init/parser.cpp;l=144;drc=61197364367c9e404c7da6900658f1b16c42d0da
+// https://cs.android.com/android/platform/superproject/main/+/main:system/libbase/file.cpp;l=241-243;drc=61197364367c9e404c7da6900658f1b16c42d0da
+// The system will read init.rc file until EOF, whenever read() returns 0,
+// so we begin append ksu rc when we meet EOF.
+
+static ssize_t read_proxy(struct file *file, char __user *buf, size_t count,
+                          loff_t *pos)
+{
+    ssize_t ret = 0;
+    size_t append_count;
+    if (ksu_rc_pos && ksu_rc_pos < ksu_rc_len)
+        goto append_ksu_rc;
+
+    ret = orig_read(file, buf, count, pos);
+    if (ret != 0 || ksu_rc_pos >= ksu_rc_len) {
+        return ret;
+    } else {
+        pr_info("read_proxy: orig read finished, start append rc\n");
+    }
+append_ksu_rc:
+    append_count = ksu_rc_len - ksu_rc_pos;
+    if (append_count > count - ret)
+        append_count = count - ret;
+    // copy_to_user returns the number of not copied
+    if (copy_to_user(buf + ret, KERNEL_SU_RC + ksu_rc_pos, append_count)) {
+        pr_info("read_proxy: append error, totally appended %ld\n", ksu_rc_pos);
+    } else {
+        pr_info("read_proxy: append %ld\n", append_count);
+
+        ksu_rc_pos += append_count;
+        if (ksu_rc_pos == ksu_rc_len) {
+            pr_info("read_proxy: append done\n");
+        }
+        ret += append_count;
+    }
+
+    return ret;
+}
+
+static ssize_t read_iter_proxy(struct kiocb *iocb, struct iov_iter *to)
+{
+    ssize_t ret = 0;
+    size_t append_count;
+    if (ksu_rc_pos && ksu_rc_pos < ksu_rc_len)
+        goto append_ksu_rc;
+
+    ret = orig_read_iter(iocb, to);
+    if (ret != 0 || ksu_rc_pos >= ksu_rc_len) {
+        return ret;
+    } else {
+        pr_info("read_iter_proxy: orig read finished, start append rc\n");
+    }
+append_ksu_rc:
+    // copy_to_iter returns the number of copied bytes
+    append_count =
+        copy_to_iter(KERNEL_SU_RC + ksu_rc_pos, ksu_rc_len - ksu_rc_pos, to);
+    if (!append_count) {
+        pr_info("read_iter_proxy: append error, totally appended %ld\n",
+                ksu_rc_pos);
+    } else {
+        pr_info("read_iter_proxy: append %ld\n", append_count);
+
+        ksu_rc_pos += append_count;
+        if (ksu_rc_pos == ksu_rc_len) {
+            pr_info("read_iter_proxy: append done\n");
+        }
+        ret += append_count;
+    }
+    return ret;
+}
+
+static bool is_init_rc(struct file *fp)
+{
+    if (strcmp(current->comm, "init")) {        // we are only interest in `init` process
+        return false;
+    }
+
+    if (!d_is_reg(fp->f_path.dentry)) {
+        return false;
+    }
+
+    const char *short_name = fp->f_path.dentry->d_name.name;
+    if (strcmp(short_name, "init.rc")) {
+        // we are only interest `init.rc` file name file
+        return false;
+    }
+    char path[256];
+    char *dpath = d_path(&fp->f_path, path, sizeof(path));
+
+    if (IS_ERR(dpath)) {
+        return false;
+    }
+
+    /*
+     * init.rc 的真实路径随 Android 版本变化，必须同时匹配：
+     *   - Android 10+ : /system/etc/init/hw/init.rc
+     *   - Android 9 及以前（本机 EMUI 9.1 / Android 9）: /init.rc
+     * 上游只判断前者，导致在 Android 9 上 is_init_rc() 恒为 false，
+     * KERNEL_SU_RC 永不注入 -> init 不执行 `ksud post-fs-data`
+     * -> 模块系统整体失效（表现为「刷入的模块重启不生效」）。
+     * 本机实测：/init.rc 存在(36412B)，/system/etc/init/hw/init.rc 不存在。
+     */
+    if (strcmp(dpath, "/system/etc/init/hw/init.rc") &&
+        strcmp(dpath, "/init.rc")) {
+        return false;
+    }
+
+    return true;
+}
+
+/* 供 fs/stat.c 的 vfs_fstat() 调用（源码级直钩）。
+ *
+ * 目的：init 读 /init.rc 时我们会把 KERNEL_SU_RC 追加到文件末尾
+ * （见 read_proxy / read_iter_proxy），若 init 用 fstat 的 st_size 预分配
+ * 缓冲区，就必须让它看到"追加后"的长度，否则最后一段 KERNEL_SU_RC 会被截断。
+ *
+ * 上游用 kretprobe 挂 __arm64_sys_newfstat 做这件事，但两条路都不通：
+ *   - 本内核 CONFIG_KPROBES=n，register_kretprobe() 恒返回 -ENOSYS；
+ *   - arm64 上根本没有 __arm64_sys_newfstat 这个符号（那是 x86 的命名）。
+ * 所以改成在 vfs_fstat() 里直接修正 —— 顺带覆盖所有走 fd 的 stat 路径。
+ *
+ * 注：Android 9 的 init 走 read() 循环读 EOF、并不依赖 st_size（本机实测
+ * 注入完整：`append 351` + `append done`）；本钩子是为机制完整性而补，
+ * Android 10+ 的 init 会用 fstat 预分配，那时它是必需的。
+ */
+void ksu_fixup_init_rc_stat(struct file *fp, struct kstat *stat)
+{
+    if (is_init_rc(fp)) {
+        stat->size += ksu_rc_len;
+    }
+}
+
+/* 供 syscall tracepoint (sys_enter, __NR_read) 调用。
+ * 原实现是 kprobe 挂 __arm64_sys_read，但本内核 CONFIG_KPROBES=n，
+ * register_kprobe() 恒返回 -ENOSYS，钩子永远不会生效。 */
+void ksu_handle_sys_read(unsigned int fd)
+{
+    struct file *file = fget(fd);
+    if (!file) {
+        return;
+    }
+
+    if (!is_init_rc(file)) {
+        goto skip;
+    }
+
+    // we only process the first read
+    static bool rc_hooked = false;
+    if (rc_hooked) {
+        // we don't need these kprobe, unregister it!
+        stop_init_rc_hook();
+        goto skip;
+    }
+    rc_hooked = true;
+
+    // now we can sure that the init process is reading
+    // `/system/etc/init/init.rc`
+
+    pr_info("read init.rc, comm: %s, rc_count: %zu\n", current->comm,
+            ksu_rc_len);
+
+    /* Android 9 补位：此刻（本机 15.93s）SELinux 策略已加载完成（15.86s），
+     * 而 init 执行 ksud 要到 19.78s —— 在这里异步应用 KSU 规则，
+     * 是"能切回 Enforcing"所必需的最早可用时机。见文件上方长注释。 */
+    ksu_apply_selinux_rules_async();
+
+    // Now we need to proxy the read and modify the result!
+    // But, we can not modify the file_operations directly, because it's in read-only memory.
+    // We just replace the whole file_operations with a proxy one.
+    memcpy(&fops_proxy, file->f_op, sizeof(struct file_operations));
+    orig_read = file->f_op->read;
+    if (orig_read) {
+        fops_proxy.read = read_proxy;
+    }
+    orig_read_iter = file->f_op->read_iter;
+    if (orig_read_iter) {
+        fops_proxy.read_iter = read_iter_proxy;
+    }
+    // replace the file_operations
+    file->f_op = &fops_proxy;
+
+skip:
+    fput(file);
+}
+
+static unsigned int volumedown_pressed_count = 0;
+
+static bool is_volumedown_enough(unsigned int count)
+{
+    return count >= 3;
+}
+
+int ksu_handle_input_handle_event(unsigned int *type, unsigned int *code,
+                                  int *value)
+{
+    if (*type == EV_KEY && *code == KEY_VOLUMEDOWN) {
+        int val = *value;
+        pr_info("KEY_VOLUMEDOWN val: %d\n", val);
+        if (val) {
+            // key pressed, count it
+            volumedown_pressed_count += 1;
+            if (is_volumedown_enough(volumedown_pressed_count)) {
+                stop_input_hook();
+            }
+        }
+    }
+
+    return 0;
+}
+
+bool ksu_is_safe_mode()
+{
+    static bool safe_mode = false;
+    if (safe_mode) {
+        // don't need to check again, userspace may call multiple times
+        return true;
+    }
+
+    // stop hook first!
+    stop_input_hook();
+
+    pr_info("volumedown_pressed_count: %d\n", volumedown_pressed_count);
+    if (is_volumedown_enough(volumedown_pressed_count)) {
+        // pressed over 3 times
+        pr_info("KEY_VOLUMEDOWN pressed max times, safe mode detected!\n");
+        safe_mode = true;
+        return true;
+    }
+
+    return false;
+}
+
+static int sys_execve_handler_pre(struct kprobe *p, struct pt_regs *regs)
+{
+    struct pt_regs *real_regs = PT_REAL_REGS(regs);
+    const char __user **filename_user =
+        (const char **)&PT_REGS_PARM1(real_regs);
+    const char __user *const __user *__argv =
+        (const char __user *const __user *)PT_REGS_PARM2(real_regs);
+    struct user_arg_ptr argv = { .ptr.native = __argv };
+    struct filename filename_in, *filename_p;
+    char path[32];
+    long ret;
+    unsigned long addr;
+    const char __user *fn;
+
+    if (!filename_user)
+        return 0;
+
+    addr = untagged_addr((unsigned long)*filename_user);
+    fn = (const char __user *)addr;
+
+    memset(path, 0, sizeof(path));
+    ret = strncpy_from_user_nofault(path, fn, 32);
+    if (ret < 0 && try_set_access_flag(addr)) {
+        ret = strncpy_from_user_nofault(path, fn, 32);
+    }
+    if (ret < 0) {
+        pr_err("Access filename failed for execve_handler_pre\n");
+        return 0;
+    }
+    filename_in.name = path;
+
+    filename_p = &filename_in;
+    return ksu_handle_execveat_ksud(AT_FDCWD, &filename_p, &argv, NULL, NULL);
+}
+
+static int sys_read_handler_pre(struct kprobe *p, struct pt_regs *regs)
+{
+    struct pt_regs *real_regs = PT_REAL_REGS(regs);
+    unsigned int fd = PT_REGS_PARM1(real_regs);
+
+    ksu_handle_sys_read(fd);
+    return 0;
+}
+
+/*
+ * 已删除的 kprobe 处理函数（sys_fstat_handler_pre/post、
+ * input_handle_event_handler_pre）—— 它们服务的 kprobe 在本内核
+ * （CONFIG_KPROBES=n）永远注册不上，已由源码级直钩取代：
+ *   - st_size 修正 -> fs/stat.c 的 vfs_fstat() 调用 ksu_fixup_init_rc_stat()
+ *   - 音量下键安全模式 -> drivers/input/input.c 的 input_event() 调用
+ *                        ksu_handle_input_handle_event()
+ * 保留它们只会在将来万一打开 KPROBES 时造成**重复处理**
+ * （st_size 被加两次 / 音量键按 2 次就触发安全模式），故一并移除。
+ */
+
+static struct kprobe execve_kp = {
+    .symbol_name = SYS_EXECVE_SYMBOL,
+    .pre_handler = sys_execve_handler_pre,
+};
+
+static struct kprobe sys_read_kp = {
+    .symbol_name = SYS_READ_SYMBOL,
+    .pre_handler = sys_read_handler_pre,
+};
+
+static void do_stop_init_rc_hook(struct work_struct *work)
+{
+    unregister_kprobe(&sys_read_kp);
+}
+
+static void do_stop_execve_hook(struct work_struct *work)
+{
+    unregister_kprobe(&execve_kp);
+}
+
+static void stop_init_rc_hook()
+{
+    static bool init_rc_hook_stopped = false;
+    if (init_rc_hook_stopped) {
+        return;
+    }
+    init_rc_hook_stopped = true;
+    bool ret = schedule_work(&stop_init_rc_hook_work);
+    pr_info("unregister init_rc_hook kprobe: %d!\n", ret);
+}
+
+static void stop_execve_hook()
+{
+    bool ret = schedule_work(&stop_execve_hook_work);
+    pr_info("unregister execve kprobe: %d!\n", ret);
+}
+
+static void stop_input_hook()
+{
+    static bool input_hook_stopped = false;
+    if (input_hook_stopped) {
+        return;
+    }
+    input_hook_stopped = true;
+    /* 源码级直钩（drivers/input/input.c 的 input_event()）：
+     * 把开关置 0 即停止回调，无需注销 kprobe。 */
+    ksu_input_hook_active = false;
+    pr_info("stop input hook\n");
+}
+
+// ksud: module support
+void ksu_ksud_init()
+{
+    int ret;
+
+    /*
+     * ⚠️ 本内核 CONFIG_KPROBES=n，register_kprobe()/register_kretprobe() 是
+     *    返回 -ENOSYS 的空桩，下面 2 次注册**全部失败**（dmesg 可见
+     *    `KernelSU: reboot kprobe failed: -38` 同源）。此外 arch.h 里的
+     *    SYS_*_SYMBOL 用的是 4.17+ 的 `__arm64_sys_*` 命名，而 4.9 实际符号
+     *    是 `SyS_*`，即便打开 KPROBES 也会因找不到符号返回 -ENOENT。
+     *
+     *    因此 4 个 ksud 钩子的实际驱动路径如下：
+     *      - execve      -> syscall tracepoint（sys_enter, __NR_execve）
+     *                       -> ksu_handle_execve_ksud()
+     *      - read        -> syscall tracepoint（sys_enter, __NR_read）
+     *                       -> ksu_handle_sys_read()   （init.rc 注入）
+     *      - newfstat    -> 源码级直钩 fs/stat.c:vfs_fstat()
+     *                       -> ksu_fixup_init_rc_stat() （修正 st_size）
+     *      - input_event -> 源码级直钩 drivers/input/input.c:input_event()
+     *                       -> ksu_handle_input_handle_event()（音量键安全模式）
+     *    后两个没有可用的 tracepoint 可挂（4.9 没有 input 子系统 tracepoint，
+     *    而 fstat 需要"返回值"语义），故走源码级直钩 —— 与 kernel/reboot.c
+     *    的 SukiSU 超级调用同一手法。
+     *
+     *    下面保留 execve/read 的注册调用仅为最小化改动：两者都幂等
+     *    （execve 侧 on_post_fs_data 有 done 门、规则应用有 done 门；
+     *      read 侧有 rc_hooked 门），失败无副作用（unregister 同为空白桩）。
+     *    fstat/input 的 kprobe 注册已删除，避免将来打开 KPROBES 时重复处理。
+     */
+    ret = register_kprobe(&execve_kp);
+    pr_info("ksud: execve_kp: %d (kprobe disabled, tracepoint path in use)\n",
+            ret);
+
+    ret = register_kprobe(&sys_read_kp);
+    pr_info("ksud: sys_read_kp: %d (kprobe disabled, tracepoint path in use)\n",
+            ret);
+
+    INIT_WORK(&stop_init_rc_hook_work, do_stop_init_rc_hook);
+    INIT_WORK(&stop_execve_hook_work, do_stop_execve_hook);
+    INIT_WORK(&apply_ksu_selinux_rules_work, do_apply_ksu_selinux_rules);
+}
+
+void ksu_ksud_exit()
+{
+    unregister_kprobe(&execve_kp);
+    // this should be done before unregister sys_read_kp
+    // unregister_kprobe(&sys_read_kp);
+}
