+/*********/
+/* MACRO */
+/*********/
+#define getname_safe(name) (name == NULL ? ERR_PTR(-EINVAL) : getname(name))
+#define putname_safe(name) (IS_ERR(name) ? NULL : putname(name))
+
+/**********/
+/* STRUCT */
+/**********/
+/* sus_path -- UAPI */
+#ifdef CONFIG_KSU_SUSFS_SUS_PATH
+/*
+ * Two payload layouts exist in the wild and BOTH must be accepted:
+ *
+ *   v2.3.0  (SukiSU >= 4.2 ksud / ksu_susfs >= 2.3.0)
+ *       char target_pathname[256];  int err;              err @ 256
+ *
+ *   v2.0.0  (SukiSU Ultra 4.1.x -- the only tool it bundles is
+ *            assets/ksu_susfs_2.0.0, see below)
+ *       unsigned long target_ino;   char target_pathname[256];
+ *       unsigned int  target_uid;   int err;              err @ 268
+ *
+ * The manager picks its tool from the version the kernel reports:
+ *   "ksu_susfs_" + <version>; if that asset is missing it falls back to
+ *   ksu_susfs_2.0.0.  SukiSU Ultra 4.1.1 only ships the 2.0.0 tool, so that
+ *   is what actually drives the SUSFS screen -- hence the v2.0.0 layout here.
+ *   Reporting the v2.3.0 layout too keeps ksud (and any future manager that
+ *   ships a 2.3.0 tool) working.
+ *
+ * The kernel resolves the inode from the pathname itself, so target_ino /
+ * target_uid are ignored on input; only the pathname and err offsets differ.
+ */
+struct st_susfs_sus_path {
+	char                             target_pathname[SUSFS_MAX_LEN_PATHNAME];
+	int                              err;
+};
+
+/* v2.0.0 wire layout (SukiSU Ultra 4.1.x bundled ksu_susfs tool). */
+struct st_susfs_sus_path_v200 {
+	unsigned long                    target_ino;
+	char                             target_pathname[SUSFS_MAX_LEN_PATHNAME];
+	unsigned int                     target_uid;
+	int                              err;
+};
+
+struct st_susfs_sus_path_hlist {
+	unsigned long                    target_ino;
+	char                             target_pathname[SUSFS_MAX_LEN_PATHNAME];
+	struct hlist_node                node;
+};
+
+/*
+ * sus_path_loop -- re-flag list.
+ *
+ * Plain sus_path flags the inode once.  If the file is later replaced (an app
+ * update rewrites it) the inode changes and the flag is lost, so paths
+ * registered through CMD_SUSFS_ADD_SUS_PATH_LOOP are remembered here and
+ * re-flagged from a workqueue on every setresuid -- see
+ * susfs_run_sus_path_loop() in fs/susfs.c.
+ */
+struct st_susfs_sus_path_list {
+	struct list_head                 list;
+	char                             target_pathname[SUSFS_MAX_LEN_PATHNAME];
+	size_t                           path_len;
+	/*
+	 * Consecutive re-flag failures.  The re-flag runs in a kworker whose
+	 * SELinux domain is "kernel"; a path that domain cannot search can
+	 * never be resolved there, so once this reaches
+	 * SUSFS_SUS_PATH_LOOP_MAX_RETRY the entry is dropped from the list
+	 * rather than retried on every setresuid.
+	 */
+	u32                              fail_count;
+};
+#endif
+
+/* sus_mount -- UAPI (v2.3.0: ADD_SUS_MOUNT is deprecated, this toggle replaces it) */
+#ifdef CONFIG_KSU_SUSFS_SUS_MOUNT
+struct st_susfs_hide_sus_mnts_for_non_su_procs {
+	bool                             enabled;
+	int                              err;
+};
+
+struct st_susfs_sus_mount {
+	char                    target_pathname[SUSFS_MAX_LEN_PATHNAME];
+	unsigned long           target_dev;
+};
+
+struct st_susfs_sus_mount_list {
+	struct list_head                        list;
+	struct st_susfs_sus_mount               info;
+};
+#endif
+
+/* sus_kstat -- UAPI (v2.3.0 field order!) */
+#ifdef CONFIG_KSU_SUSFS_SUS_KSTAT
+struct st_susfs_sus_kstat {
+	bool                                    is_statically;
+	unsigned long                           target_ino; // the ino after bind mounted or overlayed
+	char                                    target_pathname[SUSFS_MAX_LEN_PATHNAME];
+	unsigned long                           spoofed_ino;
+	unsigned long                           spoofed_dev;
+	unsigned int                            spoofed_nlink;
+	long long                               spoofed_size;
+	long                                    spoofed_atime_tv_sec;
+	unsigned long                           spoofed_atime_tv_nsec;
+	long                                    spoofed_mtime_tv_sec;
+	unsigned long                           spoofed_mtime_tv_nsec;
+	long                                    spoofed_ctime_tv_sec;
+	unsigned long                           spoofed_ctime_tv_nsec;
+	long long                               spoofed_blocks;
+	long                                    spoofed_blksize;
+	int                                     flags;
+	int                                     err;
+};
+
+/*
+ * v2.0.0 wire layout (SukiSU Ultra 4.1.x bundled ksu_susfs tool).
+ *
+ * Identical to the v2.3.0 struct above except that `int flags` is absent, so
+ * the trailing `err` sits at 368 instead of 372. Every field up to and
+ * including spoofed_blksize keeps the same offset, which is why the two
+ * layouts are interchangeable apart from the reply slot.
+ */
+struct st_susfs_sus_kstat_v200 {
+	bool                                    is_statically;
+	unsigned long                           target_ino;
+	char                                    target_pathname[SUSFS_MAX_LEN_PATHNAME];
+	unsigned long                           spoofed_ino;
+	unsigned long                           spoofed_dev;
+	unsigned int                            spoofed_nlink;
+	long long                               spoofed_size;
+	long                                    spoofed_atime_tv_sec;
+	unsigned long                           spoofed_atime_tv_nsec;
+	long                                    spoofed_mtime_tv_sec;
+	unsigned long                           spoofed_mtime_tv_nsec;
+	long                                    spoofed_ctime_tv_sec;
+	unsigned long                           spoofed_ctime_tv_nsec;
+	long long                               spoofed_blocks;
+	long                                    spoofed_blksize;
+	int                                     err;
+};
+
+struct st_susfs_sus_kstat_hlist {
+	unsigned long                           target_ino;
+	struct st_susfs_sus_kstat               info;
+	struct hlist_node                       node;
+};
+#endif
