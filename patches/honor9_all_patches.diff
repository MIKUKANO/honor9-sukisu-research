+/* 幂等：重复调用只会入队一次；work 自身也带 done 门。 */
+void ksu_apply_selinux_rules_async(void)
+{
+    if (ksu_selinux_rules_done) {
+        return;
+    }
+    schedule_work(&apply_ksu_selinux_rules_work);
+}
