+/* open_redirect */
+#ifdef CONFIG_KSU_SUSFS_OPEN_REDIRECT
+static DEFINE_HASHTABLE(OPEN_REDIRECT_HLIST, 10);
+static int susfs_update_open_redirect_inode(struct st_susfs_open_redirect_hlist *new_entry) {
+	struct path path_target;
+	struct inode *inode_target;
+	int err = 0;
+
+	err = kern_path(new_entry->target_pathname, LOOKUP_FOLLOW, &path_target);
+	if (err) {
+		SUSFS_LOGE("Failed opening file '%s'\n", new_entry->target_pathname);
+		return err;
+	}
+
+	inode_target = d_inode(path_target.dentry);
+	if (!inode_target) {
+		SUSFS_LOGE("inode_target is NULL\n");
+		err = 1;
+		goto out_path_put_target;
+	}
+
+	spin_lock(&inode_target->i_lock);
+	inode_target->i_state |= INODE_STATE_OPEN_REDIRECT;
+	spin_unlock(&inode_target->i_lock);
+
+out_path_put_target:
+	path_put(&path_target);
+	return err;
+}
+
+/* err lives at a different offset in each layout (516 vs 520). */
+static unsigned long susfs_open_redirect_err_offset(int path_off)
+{
+	return path_off ? offsetof(struct st_susfs_open_redirect_v200, err)
+			: offsetof(struct st_susfs_open_redirect, err);
+}
+
+/* Dual-layout, same rationale as susfs_add_sus_path(): the v2.0.0 tool that
+ * SukiSU Ultra 4.1.x actually ships prepends an 8-byte target_ino, so the two
+ * pathnames have to be fetched field by field instead of copying the struct. */
+void susfs_add_open_redirect(void __user **user_info) {
+	struct st_susfs_open_redirect info = {0};
+	struct st_susfs_open_redirect_hlist *new_entry, *tmp_entry;
+	struct hlist_node *tmp_node;
+	void __user *base = *user_info;
+	unsigned long err_off = offsetof(struct st_susfs_open_redirect, err);
+	struct path p;
+	int bkt, path_off;
+	bool update_hlist = false;
+
+	path_off = susfs_pathname_offset(base);
+	if (path_off < 0) {
+		info.err = path_off;
+		path_off = 0;			/* best-effort reply slot */
+		goto out_copy_to_user;
+	}
+	err_off = susfs_open_redirect_err_offset(path_off);
+
+	if (copy_from_user(info.target_pathname, (char __user *)base + path_off,
+			sizeof(info.target_pathname))) {
+		info.err = -EFAULT;
+		goto out_copy_to_user;
+	}
+	info.target_pathname[SUSFS_MAX_LEN_PATHNAME - 1] = '\0';
+
+	if (copy_from_user(info.redirected_pathname,
+			(char __user *)base + path_off + SUSFS_MAX_LEN_PATHNAME,
+			sizeof(info.redirected_pathname))) {
+		info.err = -EFAULT;
+		goto out_copy_to_user;
+	}
+	info.redirected_pathname[SUSFS_MAX_LEN_PATHNAME - 1] = '\0';
+
+	info.err = kern_path(info.target_pathname, LOOKUP_FOLLOW, &p);
+	if (info.err) {
+		SUSFS_LOGE("failed opening file '%s'\n", info.target_pathname);
+		goto out_copy_to_user;
+	}
+	path_put(&p);
+
+	spin_lock(&susfs_spin_lock);
+	hash_for_each_safe(OPEN_REDIRECT_HLIST, bkt, tmp_node, tmp_entry, node) {
+		if (!strcmp(tmp_entry->target_pathname, info.target_pathname)) {
+			hash_del(&tmp_entry->node);
+			kfree(tmp_entry);
+			update_hlist = true;
+			break;
+		}
+	}
+	spin_unlock(&susfs_spin_lock);
+
+	new_entry = kmalloc(sizeof(struct st_susfs_open_redirect_hlist), GFP_KERNEL);
+	if (!new_entry) {
+		SUSFS_LOGE("no enough memory\n");
+		info.err = -ENOMEM;
+		goto out_copy_to_user;
+	}
+
+	strncpy(new_entry->target_pathname, info.target_pathname, SUSFS_MAX_LEN_PATHNAME-1);
+	strncpy(new_entry->redirected_pathname, info.redirected_pathname, SUSFS_MAX_LEN_PATHNAME-1);
+	if (susfs_update_open_redirect_inode(new_entry)) {
+		SUSFS_LOGE("failed adding path '%s' to OPEN_REDIRECT_HLIST\n", new_entry->target_pathname);
+		kfree(new_entry);
+		info.err = -ENOENT;
+		goto out_copy_to_user;
+	}
+
+	info.err = kern_path(new_entry->target_pathname, LOOKUP_FOLLOW, &p);
+	if (info.err) {
+		kfree(new_entry);
+		goto out_copy_to_user;
+	}
+	new_entry->target_ino = d_inode(p.dentry)->i_ino;
+	path_put(&p);
+
+	spin_lock(&susfs_spin_lock);
+	hash_add(OPEN_REDIRECT_HLIST, &new_entry->node, new_entry->target_ino);
+	spin_unlock(&susfs_spin_lock);
+	SUSFS_LOGI("target_ino: '%lu', target_pathname: '%s', redirected_pathname: '%s', is successfully %s to OPEN_REDIRECT_HLIST\n",
+			new_entry->target_ino, new_entry->target_pathname, new_entry->redirected_pathname,
+			update_hlist ? "updated" : "added");
+	info.err = 0;
+out_copy_to_user:
+	if (copy_to_user((char __user *)base + err_off, &info.err, sizeof(info.err))) {
+		info.err = -EFAULT;
+	}
+	SUSFS_LOGI("CMD_SUSFS_ADD_OPEN_REDIRECT -> ret: %d\n", info.err);
+}
+
+struct filename* susfs_get_redirected_path(unsigned long ino) {
+	struct st_susfs_open_redirect_hlist *entry;
+
+	hash_for_each_possible(OPEN_REDIRECT_HLIST, entry, node, ino) {
+		if (entry->target_ino == ino) {
+			SUSFS_LOGI("Redirect for ino: %lu\n", ino);
+			return getname_kernel(entry->redirected_pathname);
+		}
+	}
+	return ERR_PTR(-ENOENT);
+}
+#endif // #ifdef CONFIG_KSU_SUSFS_OPEN_REDIRECT
