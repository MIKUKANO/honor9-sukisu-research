index 000000000..2655f07ec
--- /dev/null
+++ b/drivers/kernelsu/supercalls.c
@@ -0,0 +1,1320 @@
+#include <linux/anon_inodes.h>
+#include <linux/capability.h>
+#include <linux/cred.h>
+#include <linux/err.h>
+#include <linux/fdtable.h>
