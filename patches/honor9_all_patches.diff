+#define SUSFS_ERR_OFF_PATHNAME offsetof(struct st_susfs_sus_path, err)
+
+/*
+ * SUSFS command dispatcher, driven by the reboot() magic protocol that
+ * SukiSU Ultra >= 4.1.x uses:
+ *   reboot(KSU_INSTALL_MAGIC1, SUSFS_MAGIC, cmd, (unsigned long)arg)
+ */
+static void ksu_handle_susfs_cmd(unsigned int cmd, void __user *arg)
+{
+    if (current_uid().val != 0) {
+        return;
+    }
+    if (!arg) {
+        pr_err("susfs: cmd 0x%x with NULL arg\n", cmd);
+        return;
+    }
+
+    switch (cmd) {
+#ifdef CONFIG_KSU_SUSFS_SUS_PATH
+    case CMD_SUSFS_ADD_SUS_PATH:
+        /*
+         * Validate against the *larger* of the two accepted wire layouts.
+         * SukiSU Ultra 4.1.x ships ksu_susfs_2.0.0, whose payload carries an
+         * extra 8-byte target_ino prefix (272 B total) on top of the v2.3.0
+         * layout (264 B). Both must pass, so size the check on the legacy one.
+         */
+        if (!ksu_access_ok(arg, sizeof(struct st_susfs_sus_path_v200))) {
+            pr_err("susfs: CMD_SUSFS_ADD_SUS_PATH -> arg is not accessible\n");
+            return;
+        }
+        susfs_add_sus_path(&arg);
+        return;
+#endif
+#ifdef CONFIG_KSU_SUSFS_SUS_MOUNT
+    case CMD_SUSFS_HIDE_SUS_MNTS_FOR_NON_SU_PROCS:
+        if (!ksu_access_ok(arg, sizeof(struct st_susfs_hide_sus_mnts_for_non_su_procs))) {
+            pr_err("susfs: CMD_SUSFS_HIDE_SUS_MNTS_FOR_NON_SU_PROCS -> arg is not accessible\n");
+            return;
+        }
+        susfs_set_hide_sus_mnts_for_non_su_procs(&arg);
+        return;
+#endif
+#ifdef CONFIG_KSU_SUSFS_SUS_KSTAT
+    case CMD_SUSFS_ADD_SUS_KSTAT:
+        if (!ksu_access_ok(arg, sizeof(struct st_susfs_sus_kstat))) {
+            pr_err("susfs: CMD_SUSFS_ADD_SUS_KSTAT -> arg is not accessible\n");
+            return;
+        }
+        susfs_add_sus_kstat(&arg);
+        return;
+    case CMD_SUSFS_UPDATE_SUS_KSTAT:
+        if (!ksu_access_ok(arg, sizeof(struct st_susfs_sus_kstat))) {
+            pr_err("susfs: CMD_SUSFS_UPDATE_SUS_KSTAT -> arg is not accessible\n");
+            return;
+        }
+        susfs_update_sus_kstat(&arg);
+        return;
+    case CMD_SUSFS_ADD_SUS_KSTAT_STATICALLY:
+        if (!ksu_access_ok(arg, sizeof(struct st_susfs_sus_kstat))) {
+            pr_err("susfs: CMD_SUSFS_ADD_SUS_KSTAT_STATICALLY -> arg is not accessible\n");
+            return;
+        }
+        susfs_add_sus_kstat(&arg);
+        return;
+#endif
+#ifdef CONFIG_KSU_SUSFS_SPOOF_UNAME
+    case CMD_SUSFS_SET_UNAME:
+        if (!ksu_access_ok(arg, sizeof(struct st_susfs_uname))) {
+            pr_err("susfs: CMD_SUSFS_SET_UNAME -> arg is not accessible\n");
+            return;
+        }
+        susfs_set_uname(&arg);
+        return;
+#endif
+#ifdef CONFIG_KSU_SUSFS_ENABLE_LOG
+    case CMD_SUSFS_ENABLE_LOG:
+        if (!ksu_access_ok(arg, sizeof(struct st_susfs_log))) {
+            pr_err("susfs: CMD_SUSFS_ENABLE_LOG -> arg is not accessible\n");
+            return;
+        }
+        susfs_enable_log(&arg);
+        return;
+#endif
+#ifdef CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG
+    case CMD_SUSFS_SET_CMDLINE_OR_BOOTCONFIG:
+        if (!ksu_access_ok(arg, sizeof(struct st_susfs_spoof_cmdline_or_bootconfig))) {
+            pr_err("susfs: CMD_SUSFS_SET_CMDLINE_OR_BOOTCONFIG -> arg is not accessible\n");
+            return;
+        }
+        susfs_set_cmdline_or_bootconfig(&arg);
+        return;
+#endif
+#ifdef CONFIG_KSU_SUSFS_OPEN_REDIRECT
+    case CMD_SUSFS_ADD_OPEN_REDIRECT:
+        /* Same dual-layout rationale as CMD_SUSFS_ADD_SUS_PATH above:
+         * v2.3.0 is 520 B, v2.0.0 is 524 B -- validate on the larger one. */
+        if (!ksu_access_ok(arg, sizeof(struct st_susfs_open_redirect_v200))) {
+            pr_err("susfs: CMD_SUSFS_ADD_OPEN_REDIRECT -> arg is not accessible\n");
+            return;
+        }
+        susfs_add_open_redirect(&arg);
+        return;
+#endif
+    case CMD_SUSFS_SHOW_VERSION:
+        if (!ksu_access_ok(arg, sizeof(struct st_susfs_version))) {
+            pr_err("susfs: CMD_SUSFS_SHOW_VERSION -> arg is not accessible\n");
+            return;
+        }
+        susfs_show_version(&arg);
+        return;
+    case CMD_SUSFS_SHOW_VARIANT:
+        if (!ksu_access_ok(arg, sizeof(struct st_susfs_variant))) {
+            pr_err("susfs: CMD_SUSFS_SHOW_VARIANT -> arg is not accessible\n");
+            return;
+        }
+        susfs_show_variant(&arg);
+        return;
+    case CMD_SUSFS_SHOW_ENABLED_FEATURES:
+        if (!ksu_access_ok(arg, sizeof(struct st_susfs_enabled_features))) {
+            pr_err("susfs: CMD_SUSFS_SHOW_ENABLED_FEATURES -> arg is not accessible\n");
+            return;
+        }
+        susfs_get_enabled_features(&arg);
+        return;
+
+    /* ---- sus_path_loop: re-flag registered paths on every setresuid ---- */
+#ifdef CONFIG_KSU_SUSFS_SUS_PATH
+    case CMD_SUSFS_ADD_SUS_PATH_LOOP:
+        /*
+         * Same dual-layout rationale as CMD_SUSFS_ADD_SUS_PATH above: the
+         * 4.1.x tool sends the v2.0.0 layout (272 B), ksud may send v2.3.0
+         * (264 B). Validate on the larger one; the handler probes the layout.
+         */
+        if (!ksu_access_ok(arg, sizeof(struct st_susfs_sus_path_v200))) {
+            pr_err("susfs: CMD_SUSFS_ADD_SUS_PATH_LOOP -> arg is not accessible\n");
+            return;
+        }
+        susfs_add_sus_path_loop(&arg);
+        return;
+#else
+    case CMD_SUSFS_ADD_SUS_PATH_LOOP:
+        if (ksu_access_ok(arg, sizeof(struct st_susfs_sus_path)))
+            susfs_reply_not_supported(arg, SUSFS_ERR_OFF_PATHNAME);
+        return;
+#endif
+    /* ---- sus_map ---- */
+#ifdef CONFIG_KSU_SUSFS_SUS_MAP
+    case CMD_SUSFS_ADD_SUS_MAP:
+        if (!ksu_access_ok(arg, sizeof(struct st_susfs_sus_map))) {
+            pr_err("susfs: CMD_SUSFS_ADD_SUS_MAP -> arg is not accessible\n");
+            return;
+        }
+        susfs_add_sus_map(&arg);
+        return;
+#else
+    case CMD_SUSFS_ADD_SUS_MAP:
+        if (ksu_access_ok(arg, sizeof(struct st_susfs_sus_map)))
+            susfs_reply_not_supported(arg, offsetof(struct st_susfs_sus_map, err));
+        return;
+#endif
+    /* ---- avc log spoofing ---- */
+#ifdef CONFIG_KSU_SUSFS_AVC_LOG_SPOOFING
+    case CMD_SUSFS_ENABLE_AVC_LOG_SPOOFING:
+        if (!ksu_access_ok(arg, sizeof(struct st_susfs_avc_log_spoofing))) {
+            pr_err("susfs: CMD_SUSFS_ENABLE_AVC_LOG_SPOOFING -> arg is not accessible\n");
+            return;
+        }
+        susfs_set_avc_log_spoofing(&arg);
+        return;
+#else
+    case CMD_SUSFS_ENABLE_AVC_LOG_SPOOFING:
+        if (ksu_access_ok(arg, sizeof(struct st_susfs_avc_log_spoofing)))
+            susfs_reply_not_supported(arg, offsetof(struct st_susfs_avc_log_spoofing, err));
+        return;
+#endif
+    /*
+     * Deprecated pre-2.3.0 commands are deliberately NOT handled here:
+     * ADD_SUS_MOUNT (0x55560), SET_ANDROID_DATA_ROOT_PATH (0x55551),
+     * SET_SDCARD_ROOT_PATH (0x55552), UMOUNT_FOR_ZYGOTE_ISO_SERVICE (0x55562),
+     * ADD_TRY_UMOUNT (0x55580), SUS_SU (0x60000), SHOW_SUS_SU_WORKING_MODE
+     * (0x555e4), IS_SUS_SU_READY (0x555f0).
+     *
+     * SUSFS v2.3.0 dropped them from the ABI, and the matching userspace tool
+     * (SukiSU Ultra 4.1.x / ksu_susfs 2.0.0) no longer even defines their
+     * command numbers -- so they can never be sent.  Upstream v2.3.0 has no
+     * case for them either; they fall through to `default`.  Their payload
+     * layouts differ per command (the trailing `int err` sits at a different
+     * offset in each), so picking one guessed offset here would risk writing
+     * past the region validated by access_ok().
+     */
+    default:
+        pr_info("susfs: unknown cmd: 0x%x\n", cmd);
+        return;
+    }
+}
+#endif // #ifdef CONFIG_KSU_SUSFS
