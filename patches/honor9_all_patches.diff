+};
+#endif
+
+/* enable_log -- UAPI (v2.3.0) */
+#ifdef CONFIG_KSU_SUSFS_ENABLE_LOG
+struct st_susfs_log {
+	bool        enabled;
+	int         err;
+};
+#endif
+
+/* spoof_cmdline_or_bootconfig -- UAPI (v2.3.0) */
