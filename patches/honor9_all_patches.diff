+static void do_apply_ksu_selinux_rules(struct work_struct *work)
+{
+    if (ksu_selinux_rules_done) {
+        return;
+    }
+    ksu_selinux_rules_done = true;
+
+    apply_kernelsu_rules();
+    cache_sid();
+    setup_ksu_cred();
+    pr_info("ksu: selinux rules applied, ksu_file_sid: %u\n", ksu_file_sid);
+}
