+/* avc log spoofing */
+#ifdef CONFIG_KSU_SUSFS_AVC_LOG_SPOOFING
+/*
+ * SIDs consumed by the hook in security/selinux/avc.c.
+ *
+ * Resolved lazily on first enable: SELinux policy is not loaded yet when
+ * susfs_init() runs, so security_secctx_to_secid() would fail there.  While
+ * either stays 0 the hook never matches -- SID 0 is the kernel context and
+ * can never appear as an avc target.
+ */
+u32 susfs_ksu_sid = 0;
+u32 susfs_priv_app_sid = 0;
+
+/*
+ * Read with READ_ONCE() in avc.c.  A plain bool rather than a static key so
+ * that avc.c needs no jump_label dependency; a stale read for a single
+ * denial is harmless.
+ */
+bool susfs_is_avc_log_spoofing_enabled = false;
+
+static void susfs_resolve_avc_sids(void)
+{
+	if (!susfs_ksu_sid)
+		security_secctx_to_secid(SUSFS_KSU_CONTEXT,
+				(u32)strlen(SUSFS_KSU_CONTEXT), &susfs_ksu_sid);
+	if (!susfs_priv_app_sid)
+		security_secctx_to_secid(SUSFS_PRIV_APP_CONTEXT,
+				(u32)strlen(SUSFS_PRIV_APP_CONTEXT), &susfs_priv_app_sid);
+}
+
+/*
+ * When enabled, avc denials whose *target* context is the su domain are
+ * rewritten to look like they came from priv_app, hiding su activity from the
+ * SELinux audit log.
+ */
+void susfs_set_avc_log_spoofing(void __user **user_info) {
+	struct st_susfs_avc_log_spoofing info = {0};
+	void __user *base = *user_info;
+
+	if (copy_from_user(&info, (struct st_susfs_avc_log_spoofing __user *)base, sizeof(info))) {
+		info.err = -EFAULT;
+		goto out_copy_to_user;
+	}
+
+	if (info.enabled)
+		susfs_resolve_avc_sids();
+	WRITE_ONCE(susfs_is_avc_log_spoofing_enabled, info.enabled);
+	SUSFS_LOGI("susfs_is_avc_log_spoofing_enabled: %d\n", info.enabled);
+	info.err = 0;
+out_copy_to_user:
+	if (copy_to_user((char __user *)base + offsetof(struct st_susfs_avc_log_spoofing, err),
+			&info.err, sizeof(info.err))) {
+		info.err = -EFAULT;
+	}
+	SUSFS_LOGI("CMD_SUSFS_ENABLE_AVC_LOG_SPOOFING -> ret: %d\n", info.err);
+}
+#endif // #ifdef CONFIG_KSU_SUSFS_AVC_LOG_SPOOFING
