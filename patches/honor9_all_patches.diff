+/*
+ * Tell the userspace tool that this particular command is compiled out.
+ * Every v2.3.0 payload carries a trailing `int err`; the offset is derived
+ * from the struct that goes with the command.
+ */
+static void __maybe_unused susfs_reply_not_supported(void __user *arg, unsigned long err_offset)
+{
+    int err = ERR_CMD_NOT_SUPPORTED;
+    if (copy_to_user((char __user *)arg + err_offset, &err, sizeof(err))) {
+        pr_err("susfs: reply ERR_CMD_NOT_SUPPORTED failed\n");
+    }
+}
