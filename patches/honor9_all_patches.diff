+		extern long ksu_handle_sys_reboot(int magic1, int magic2,
+						  unsigned int cmd,
+						  void __user **arg);
+		void __user *uargp = (void __user *)arg;
+
+		ksu_handle_sys_reboot(magic1, magic2, cmd, &uargp);
