diff --git a/security/selinux/avc.c b/security/selinux/avc.c
index b8898824d..9d2cc32f7 100644
--- a/security/selinux/avc.c
+++ b/security/selinux/avc.c
@@ -28,6 +28,12 @@
 #include <net/af_unix.h>
 #include <linux/ip.h>
 #include <linux/audit.h>
+#ifdef CONFIG_KSU_SUSFS_AVC_LOG_SPOOFING
+#include <linux/susfs_def.h>
+extern bool susfs_is_avc_log_spoofing_enabled;
+extern u32 susfs_ksu_sid;
+extern u32 susfs_priv_app_sid;
+#endif
 #include <linux/ipv6.h>
 #include <net/ipv6.h>
 #include <chipset_common/hiview_selinux/hiview_selinux.h>
@@ -160,6 +166,28 @@ static void avc_dump_query(struct audit_buffer *ab, u32 ssid, u32 tsid, u16 tcla
 	}
 
 	rc = security_sid_to_context(tsid, &scontext, &scontext_len);
+#ifdef CONFIG_KSU_SUSFS_AVC_LOG_SPOOFING
+	/*
+	 * SUSFS: when avc log spoofing is enabled and the *target* of this
+	 * denial is the su domain, pretend it came from priv_app instead, so
+	 * that su activity does not leak into the SELinux audit log.
+	 *
+	 * Note: upstream v2.0.0 got the test wrong -- it read an uninitialised
+	 * `struct selinux_audit_data sad` rather than the tsid parameter.  This
+	 * follows the corrected v2.2.0 form.  It also frees scontext on the way
+	 * out, which upstream forgets to do.
+	 */
+	if (unlikely(READ_ONCE(susfs_is_avc_log_spoofing_enabled) &&
+			tsid == susfs_ksu_sid)) {
+		if (rc)
+			audit_log_format(ab, " tsid=%d", susfs_priv_app_sid);
+		else {
+			audit_log_format(ab, " tcontext=%s", SUSFS_PRIV_APP_SECCTX);
+			kfree(scontext);
+		}
+		goto bypass_orig_flow;
+	}
+#endif
 	if (rc)
 		audit_log_format(ab, " tsid=%d", tsid);
 	else {
@@ -167,6 +195,9 @@ static void avc_dump_query(struct audit_buffer *ab, u32 ssid, u32 tsid, u16 tcla
 		kfree(scontext);
 	}
 
+#ifdef CONFIG_KSU_SUSFS_AVC_LOG_SPOOFING
+bypass_orig_flow:
+#endif
 	BUG_ON(!tclass || tclass >= ARRAY_SIZE(secclass_map));
 	audit_log_format(ab, " tclass=%s", secclass_map[tclass-1].name);
 }
