+	char                             redirected_pathname[SUSFS_MAX_LEN_PATHNAME];
+	int                              uid_scheme;
+	int                              err;
+};
+
+/* v2.0.0 wire layout (SukiSU Ultra 4.1.x bundled ksu_susfs tool):
+ * target_ino prefix, no uid_scheme, err @ 520 instead of 516. */
+struct st_susfs_open_redirect_v200 {
+	unsigned long                    target_ino;
+	char                             target_pathname[SUSFS_MAX_LEN_PATHNAME];
+	char                             redirected_pathname[SUSFS_MAX_LEN_PATHNAME];
+	int                              err;
+};
+
+struct st_susfs_open_redirect_hlist {
+	unsigned long                    target_ino;
+	char                             target_pathname[SUSFS_MAX_LEN_PATHNAME];
+	char                             redirected_pathname[SUSFS_MAX_LEN_PATHNAME];
+	struct hlist_node                node;
+};
+#endif
+
+/* sus_map -- UAPI (v2.3.0). Struct is always visible so the dispatcher can
+ * still report ERR_CMD_NOT_SUPPORTED when the feature is compiled out. */
+struct st_susfs_sus_map {
+	char                             target_pathname[SUSFS_MAX_LEN_PATHNAME];
+	int                              err;
+};
+
+/* avc log spoofing -- UAPI (v2.3.0). Always visible (see above). */
+struct st_susfs_avc_log_spoofing {
+	bool                             enabled;
+	int                              err;
+};
+
+/* show enabled features -- UAPI (v2.3.0) */
+struct st_susfs_enabled_features {
+	char                             enabled_features[SUSFS_ENABLED_FEATURES_SIZE];
+	int                              err;
+};
+
+/* show variant -- UAPI (v2.3.0) */
+struct st_susfs_variant {
+	char                             susfs_variant[SUSFS_MAX_VARIANT_BUFSIZE];
+	int                              err;
+};
+
+/* show version -- UAPI (v2.3.0) */
+struct st_susfs_version {
+	char                             susfs_version[SUSFS_MAX_VERSION_BUFSIZE];
+	int                              err;
+};
+
+/* sus_su */
+#ifdef CONFIG_KSU_SUSFS_SUS_SU
+struct st_sus_su {
+	int         mode;
+};
+#endif
+
+/***********************/
