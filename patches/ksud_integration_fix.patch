diff --git a/drivers/kernelsu/ksu_compat_49.h b/drivers/kernelsu/ksu_compat_49.h
index 0320416..c69990b 100644
--- a/drivers/kernelsu/ksu_compat_49.h
+++ b/drivers/kernelsu/ksu_compat_49.h
@@ -13,6 +13,17 @@
 #ifndef strncpy_from_user_nofault
 #define strncpy_from_user_nofault(dst, src, n) strncpy_from_user(dst, src, n)
 #endif
+/* 5.8 新增；4.9 用 probe_kernel_read/write 等价替代（同为 nofault 语义，
+ * 返回 0 表示成功）。ksud.c 的 sys_fstat kretprobe 会用到，若不映射会被
+ * 隐式声明为 int func()，运行期行为不可控。 */
+#ifndef copy_from_user_nofault
+#define copy_from_user_nofault(dst, src, size) \
+    probe_kernel_read((dst), (src), (size))
+#endif
+#ifndef copy_to_user_nofault
+#define copy_to_user_nofault(dst, src, size) \
+    probe_kernel_write((dst), (src), (size))
+#endif
 #endif
 
 #ifndef __NR_clone3
@@ -45,4 +56,57 @@ static inline void ksu_seccomp_clear_cache(struct seccomp_filter *f, int nr) {}
 #define selinux_cred(cred) ((struct task_security_struct *)((cred)->security))
 #endif
 
+/* ------------------------------------------------------------------------
+ * kernel_read() / kernel_write() 的 4.9 适配层
+ * ------------------------------------------------------------------------
+ * 这两个函数在 4.14 前后签名完全不同：
+ *
+ *   4.9  (fs/exec.c / fs/splice.c):
+ *        int     kernel_read (struct file *, loff_t offset, char *addr,
+ *                             unsigned long count);
+ *        ssize_t kernel_write(struct file *, const char *buf, size_t count,
+ *                             loff_t pos);            // pos 按值传
+ *
+ *   5.x+ (fs/read_write.c):
+ *        int     kernel_read (struct file *, void *buf, size_t count,
+ *                             loff_t *pos);
+ *        ssize_t kernel_write(struct file *, const void *buf, size_t count,
+ *                             loff_t *pos);            // pos 传指针
+ *
+ * SukiSU v4.1.1 驱动按 5.x 签名调用（第 4 个参数传 `&off`）。在 4.9 上
+ * 这个指针会被当成 offset 的“数值”，对普通文件走 vfs_write() ->
+ * rw_verify_area() 时因 pos 为负且文件不支持无符号偏移而直接返回 -EINVAL，
+ * 于是 allowlist 写盘失败（/data/adb/ksu/.allowlist 恒为 0 字节）、读盘也
+ * 失败，表现为「root 授权重启后丢失」。
+ *
+ * 下面提供两个与 5.x 语义等价的包装函数，驱动内所有调用点均已改为调用
+ * ksu_kernel_read()/ksu_kernel_write()。同时修正 4.9 版本 *不* 会自动推进
+ * 文件位置的问题（4.9 的 kernel_read/write 使用独立的局部 pos，不写回
+ * file->f_pos，因此这里手动累加 *pos，与 5.x 行为保持一致）。
+ *
+ * 注意：本头文件由 Kbuild 以 `-include` 强制注入，先于各 .c 的 #include，
+ * 因此必须自行引入 <linux/fs.h> 才能拿到 struct file / kernel_read 声明。
+ * ------------------------------------------------------------------------ */
+#if LINUX_VERSION_CODE < KERNEL_VERSION(4, 14, 0)
+#include <linux/fs.h>
+
+static inline int ksu_kernel_read(struct file *file, void *buf, size_t count,
+                                  loff_t *pos)
+{
+    int ret = kernel_read(file, *pos, (char *)buf, count);
+    if (ret > 0)
+        *pos += ret;
+    return ret;
+}
+
+static inline ssize_t ksu_kernel_write(struct file *file, const void *buf,
+                                       size_t count, loff_t *pos)
+{
+    ssize_t ret = kernel_write(file, (const char *)buf, count, *pos);
+    if (ret > 0)
+        *pos += ret;
+    return ret;
+}
+#endif
+
 #endif
